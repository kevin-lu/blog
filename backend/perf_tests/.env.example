# 性能测试配置示例

# 目标主机
TEST_TARGET_HOST=http://localhost:5000

# 压测策略
# 每阶梯持续时间（秒）
PERF_TEST_DURATION=180

# 每阶梯用户数
PERF_TEST_USERS=10

# 阶梯数量
PERF_TEST_STAGES=5

# SLA 配置
# P99 延迟要求（毫秒）
PERF_SLA_P99=500

# 错误率要求（百分比）
PERF_SLA_ERROR_RATE=1.0

# 监控配置
# 采集间隔（秒）
METRICS_INTERVAL=5

# Redis 配置（如果有）
REDIS_HOST=localhost
REDIS_PORT=6379

# 数据库配置
DB_TYPE=sqlite  # 或 mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blog
DB_USER=root
DB_PASSWORD=

# 告警阈值
ALERT_CPU_THRESHOLD=80      # CPU 使用率告警
ALERT_MEMORY_THRESHOLD=85   # 内存使用率告警
ALERT_ERROR_RATE_THRESHOLD=5  # 错误率告警
